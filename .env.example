# ── Supabase ──────────────────────────────────────────────
# Vind je in Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...   # geheim — nooit publiek maken

# ── Vercel Blob ────────────────────────────────────────────
# Auto-ingesteld als je Blob store koppelt in Vercel Dashboard
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# ── Email notificaties (optioneel) ─────────────────────────
RESEND_API_KEY=re_...
NOTIFY_EMAIL=jij@voorbeeld.nl

# ── Admin wachtwoord (niet meer nodig — vervangen door Supabase) ──
# ADMIN_PASSWORD=...
